# Copy this file to .env and fill in your own values locally.
# Never commit .env or paste your API key into chats or issues.

# Optional: enables the Gemini AI tools.
GEMINI_API_KEY=
# Optional: Gemini model name (default gemini-2.5-flash).
GEMINI_MODEL=gemini-2.5-flash

# Optional: where the SQLite account/shortlist database is stored.
# RESUME_SEARCH_DB=/path/to/resume_search.db
